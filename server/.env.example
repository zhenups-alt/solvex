PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
SOLANA_NETWORK=devnet
# Optional custom RPC endpoint (default uses clusterApiUrl(devnet))
SOLANA_RPC_URL=
# Sync interval for registered wallets
SYNC_INTERVAL_MS=30000
# JSON file used for local wallet sync persistence
SYNC_STORE_FILE=server/data/wallet-sync.json
